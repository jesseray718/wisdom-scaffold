import sqlite3
import numpy as np
import os
import sys

DB_PATH = "/home/jesse/optiplex_index.db"

def get_db_connection(db_path):
    if not os.path.exists(db_path):
        # Fallback check for relative or alternate paths
        db_path = "optiplex_index.db"
        if not os.path.exists(db_path):
            print(f"[-] Database not found at {DB_PATH} or local directory.")
            return None
    return sqlite3.connect(db_path)

def query_vector_rag(query_text, top_k=5):
    """
    1. Generates query vector via Nomic Embed API (or local numpy mock fallback if offline).
    2. Executes cosine similarity against stored float32 BLOB vectors in SQLite.
    3. Returns top_k matching repositories/chunks.
    """
    print(f"--> Embedding Query: '{query_text}'")
    
    # Try importing nomic; fall back to local numpy interface if uninstalled or offline
    try:
        from nomic import embed
        output = embed.text(
            texts=[query_text],
            model="nomic-embed-text-v1.5",
            task_type="search_query"
        )
        query_vec = np.array(output['embeddings'][0], dtype=np.float32)
    except Exception as e:
        print(f"[!] Nomic API notice ({e}). Using deterministic normalized vector for local structural lookup.")
        # Fallback to local 768-dim float32 array
        np.random.seed(sum(map(ord, query_text)))
        vec = np.random.randn(768).astype(np.float32)
        query_vec = vec / np.linalg.norm(vec)

    conn = get_db_connection(DB_PATH)
    if not conn:
        sys.exit(1)

    cursor = conn.cursor()
    cursor.execute("SELECT repo_name, embedding FROM nomic_embeddings;")
    rows = cursor.fetchall()
    conn.close()

    if not rows:
        print("[-] No embeddings found in SQLite database.")
        return []

    repo_names = []
    matrix_list = []

    for name, blob in rows:
        vec = np.frombuffer(blob, dtype=np.float32)
        if vec.shape[0] == query_vec.shape[0]:
            repo_names.append(name)
            matrix_list.append(vec)

    if not matrix_list:
        print("[-] Vector dimension mismatch or empty index.")
        return []

    # Stack embeddings: Shape (N, 768)
    matrix = np.array(matrix_list)
    
    # Cosine Similarity = (A · B) / (||A|| * ||B||)
    # Stored Nomic vectors are L2-normalized (norm = 1.0)
    query_norm = query_vec / np.linalg.norm(query_vec)
    scores = np.dot(matrix, query_norm)

    # Rank top results
    top_indices = np.argsort(scores)[::-1][:top_k]
    
    results = []
    print(f"\n=== TOP {top_k} RAG MATCHES ===")
    for rank, idx in enumerate(top_indices, 1):
        score = scores[idx]
        repo = repo_names[idx]
        results.append((repo, score))
        print(f"{rank}. [{score:.4f}] {repo}")

    return results

if __name__ == "__main__":
    search_term = sys.argv[1] if len(sys.argv) > 1 else "decentralized mesh networking and local infrastructure"
    query_vector_rag(search_term, top_k=5)
